\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces E6 (cross-substrate, $n = 10{,}000$, $d = 128$): QPS vs target selectivity $s$ on Q1 (VTC), Q7 (MV), and Q8 (Join) through DuckDB (in-process columnar), SQLite\nonbreakingspace 3 (\texttt  {:memory:}), and PostgreSQL\nonbreakingspace 17 (server-side). Colour encodes the system, linestyle encodes the substrate (solid=DuckDB, dashed=SQLite, dotted=PostgreSQL). All three substrates track each other within a few percent on each (system, category) cell, confirming that the optimizer is substrate-agnostic.}}{18}{figure.caption.30}\protected@file@percent }
\newlabel{fig:e6:real:qps}{{7}{18}{E6 (cross-substrate, $n = 10{,}000$, $d = 128$): QPS vs target selectivity $s$ on Q1 (VTC), Q7 (MV), and Q8 (Join) through DuckDB (in-process columnar), SQLite~3 (\texttt {:memory:}), and PostgreSQL~17 (server-side). Colour encodes the system, linestyle encodes the substrate (solid=DuckDB, dashed=SQLite, dotted=PostgreSQL). All three substrates track each other within a few percent on each (system, category) cell, confirming that the optimizer is substrate-agnostic}{figure.caption.30}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces E6: recall vs target selectivity on the same three categories through all three substrates. Recall matches across substrates because all three back the same pyarrow data; MosaicOpt retains $1.00$ on every cell, the pre-filter baselines drop identically on DuckDB / SQLite / PostgreSQL.}}{18}{figure.caption.32}\protected@file@percent }
\newlabel{fig:e6:real:recall}{{8}{18}{E6: recall vs target selectivity on the same three categories through all three substrates. Recall matches across substrates because all three back the same pyarrow data; MosaicOpt retains $1.00$ on every cell, the pre-filter baselines drop identically on DuckDB / SQLite / PostgreSQL}{figure.caption.32}{}}
