\newlabel{thm:m1}{{1}{6}{M1 --- Selection commutes with materialization on the materialized column}{theorem.1}{}}
\newlabel{thm:m2}{{2}{6}{M2 --- Materialization is commutative}{theorem.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Visualization of the M1 rewrite. \emph  {Left}: the input logical plan materializes $e$ on every row, then filters on $c < \tau $. \emph  {Right}: after M1, the filter is applied \emph  {before} materialization; $e$ is computed only on rows that survive the filter. The cost saving scales with the selectivity of $e < \tau $ --- substantial for tight vector ranges.}}{7}{figure.caption.8}\protected@file@percent }
\newlabel{fig:m1}{{4}{7}{Visualization of the M1 rewrite. \emph {Left}: the input logical plan materializes $e$ on every row, then filters on $c < \tau $. \emph {Right}: after M1, the filter is applied \emph {before} materialization; $e$ is computed only on rows that survive the filter. The cost saving scales with the selectivity of $e < \tau $ --- substantial for tight vector ranges}{figure.caption.8}{}}
\newlabel{thm:m3}{{3}{7}{M3 --- Materialization through projection}{theorem.3}{}}
\newlabel{thm:v1}{{4}{7}{V1 --- Vector selections on distinct columns commute}{theorem.4}{}}
\newlabel{thm:j1}{{5}{7}{J1 --- Vector selection pushdown through join}{theorem.5}{}}
\newlabel{thm:t1}{{6}{7}{T1 --- Limit after order equals top-$K$}{theorem.6}{}}
\newlabel{thm:g1}{{7}{7}{G1 --- Selection pushdown through graph expansion}{theorem.7}{}}
