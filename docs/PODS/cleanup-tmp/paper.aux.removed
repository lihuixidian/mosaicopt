\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Three-layer architecture of MosaicOpt: \emph  {application} (SQL \texttt  {ORDER BY} and \texttt  {LIMIT}, holding the fusion policy), \emph  {logical algebra} (the substrate contract including the new $\mu $ and $\Gamma $ operators, over which the equational theory is stated), and \emph  {physical algebra} (the engine implementation). The vector selection $\sigma _{\lVert V-q\rVert <\tau }$ is realized by the $H_{V,q,\tau }$ physical operator, whose concrete realization is an \emph  {ANN family} (HNSW, IVF, or brute-force linear scan); Section\nonbreakingspace \ref {sec:cbo} selects the strategy per query.}}{2}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:threelayer}{{1}{2}{Three-layer architecture of MosaicOpt: \emph {application} (SQL \texttt {ORDER BY} and \texttt {LIMIT}, holding the fusion policy), \emph {logical algebra} (the substrate contract including the new $\mu $ and $\Gamma $ operators, over which the equational theory is stated), and \emph {physical algebra} (the engine implementation). The vector selection $\sigma _{\lVert V-q\rVert <\tau }$ is realized by the $H_{V,q,\tau }$ physical operator, whose concrete realization is an \emph {ANN family} (HNSW, IVF, or brute-force linear scan); Section~\ref {sec:cbo} selects the strategy per query}{figure.caption.2}{}}
